# Settings for .sitemule/sync_build.sh

# SSH hostname or alias of your IBM i (must be in ~/.ssh/config or known_hosts)
I_HOST=MY_IBM_I

# IFS path where the project is deployed on the IBM i
DELPOY_PATH=/prj/ILEvator

# SKIP_RSYNC=true when the project is opened on the IFS share (detected automatically)

# ILEvator: the examples write their compile errors here
RSYNC_EXCLUDE="examples/errorlist.txt"
