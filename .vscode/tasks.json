{
    // Builds run on the IBM i: .sitemule/sync_build.sh rsyncs this folder to DELPOY_PATH
    // (.env) and runs gmake there - as in ILEastic.
    // See https://go.microsoft.com/fwlink/?LinkId=733558 for the tasks.json format.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile current file (and update ILEvator service program)",
            "type": "shell",
            "command": ".sitemule/sync_build.sh current \"SRC=${relativeFile}\" \"OUTPUT=*PRINT\"",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            // src/ilevator.c, 241.2: CZM0045(30) Undeclared identifier a.
            "problemMatcher": {
                "owner": "c",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "(.*), (\\d+)\\.(\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Compile Service program ILEvator",
            "type": "shell",
            "command": ".sitemule/sync_build.sh all",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Compile all example files",
            "type": "shell",
            "command": ".sitemule/sync_build.sh all DIR=examples",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Compile current example file",
            "type": "shell",
            "command": ".sitemule/sync_build.sh compile DIR=examples \"SRC=${fileBasename}\"",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            // ./IVEX01.rpgle:22,1,*RNF7030 30 The name or indicator A is not defined.
            "problemMatcher": {
                "owner": "rpg",
                "fileLocation": ["relative", "${workspaceFolder}/examples"],
                "pattern": {
                    "regexp": "^\\./(.*):(\\d+),(\\d+),(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Compile current issue file",
            "type": "shell",
            "command": ".sitemule/sync_build.sh compile DIR=issues \"SRC=${fileBasename}\"",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": {
                "owner": "rpg",
                "fileLocation": ["relative", "${workspaceFolder}/issues"],
                "pattern": {
                    "regexp": "^\\./(.*):(\\d+),(\\d+),(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Run unit tests",
            "type": "shell",
            "command": ".sitemule/sync_build.sh unittests",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Run integration tests",
            "type": "shell",
            "command": ".sitemule/sync_build.sh itests",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Sync only (no build)",
            "type": "shell",
            "command": ".sitemule/sync_build.sh sync-only",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        }
    ]
}
